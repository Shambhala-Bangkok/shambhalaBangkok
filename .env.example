# ─── Bangkok Shambhala — Environment Variables ───
# Copy this file to .env.local and fill in the values.

# Site URL (used for canonical URLs, OG images, etc.)
NEXT_PUBLIC_SITE_URL=https://shambhala-bangkok.org

# ICS Calendar feed
NEXT_PUBLIC_ICS_FEED=https://bangkok.shambhala.info/ical.php?center=362

# Gemini LLM API key
GEMINI_API_KEY=gemini-api-key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=supabase-publishable-key
SUPABASE_SECRET_KEY=supabase-secret-key

# Resend - get event data from emails
RESEND_API_KEY=resend-api-key
RESEND_EMAIL_ADDRESS=webhook-email-address
RESEND_WEBHOOK_SECRET=webhook-signing-key

# Newsletter — Brevo (Sendinblue)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_LIST_ID=1

# Analytics — Plausible (self-hosted or cloud)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=shambhala-bangkok.org

# Admin authentication (for /admin routes)
ADMIN_EMAIL=shambalabangkok@gmail.com
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32

# GitHub API — content CRUD from admin panel
GITHUB_TOKEN=ghp_your-fine-grained-personal-access-token

# Optional: Cloudflare Turnstile (captcha on admin login)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Cloudinary for image hosting
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: n8n webhook for automation triggers
N8N_WEBHOOK_URL=

# Optional: Upstash Redis (rate limiting — https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
